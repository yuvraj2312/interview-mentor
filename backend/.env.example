# ENVIRONMENT=development is the default and is correct for local dev - do
# not set this to "production" outside a real deployment. See
# docs/deployment.md for the full list of production-only requirements this
# unlocks validation for (currently: CORS_ORIGINS).
# ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://interview_mentor:interview_mentor@localhost:5433/interview_mentor
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
JWT_SECRET_KEY=generate-with-python--c-import-secrets-print-secrets-token-hex-32

REDIS_URL=redis://localhost:6380/0

MINIO_ENDPOINT_URL=http://localhost:9000
# Fine as-is for local dev (matches docker-compose.yml). In production these
# must be a real, unique object-storage credential - see docs/deployment.md.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=resumes
MINIO_SECURE=false

QDRANT_URL=http://localhost:6333

# Optional. Unset by default in dev - see docs/deployment.md for production
# values and the reasoning behind them.
# SENTRY_DSN=
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_SIGNUP=5/minute
# RATE_LIMIT_REFRESH=20/minute
